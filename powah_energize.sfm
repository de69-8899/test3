name "Energizing orb"

--every tick do
--  input fe:: from cube bottom side
--  output fe:: to injector
--end

every 20 ticks do
-- Extraction
  input except dry_ice from orb,orb_2 bottom side
  output to outbox
forget
  input dry_ice from orb_2
  output dry_ice to outbox slot 130
forget
-- ender Core
  if inbox has ge 1 ender_eye and inbox has ge 1 dielectric_casing and inbox has ge 1 capacitor_basic_tiny and orb has eq 0 then
    input 1 ender_eye, 1 dielectric_casing, 1 capacitor_basic_tiny from inbox
    output retain 1 ender_eye, 1 dielectric_casing, 1 capacitor_basic_tiny to orb
-- Charged Certus
  else if inbox has ge 1 certus_quartz_crystal and orb has eq 0 then
    input 1 certus_quartz_crystal from inbox
    output to orb
-- Energized Steel
  else if inbox has ge 1 iron_ingot and inbox has ge 1 gold_ingot and orb has eq 0 then
    input 1 each iron_ingot, gold_ingot from inbox
    output retain 1 each *ingot* to orb
-- Blaze Powder
  else if inbox has ge 4 blaze_powder and orb has eq 0 then
    input 4 blaze_powder from inbox
    output retain 4 blaze_powder to orb
-- Blaze Rod
  else if inbox has ge 1 blaze_rod and orb has eq 0 then
    input 1 blaze_rod from inbox
    output retain 1 blaze_rod to orb
-- Niotic Crystal
  else if inbox has ge 1 diamond and orb has eq 0 then
   input 1 diamond from inbox
   output retain 1 diamond to orb
-- Spirited Crystal
  else if inbox has ge 1 emerald and orb has eq 0 then
    input 1 emerald from inbox
    output retain 1 emerald to orb
-- Nitro Crystal
  else if inbox has ge 1 nether_star and inbox has ge 2 redstone_block
     and inbox has ge 1 blazing_crystal_block and orb has eq 0 then
     input 1 nether_star, 2 redstone_block, 1 blazing_crystal_block from inbox
     output retain 1 nether_star, 2 redstone_block, 1 blazing_crystal_block to orb
  else if inbox has ge 1 uranium_ingot and orb has eq 0 then
      input 1 uranium_ingot from inbox
      output retain 1 uranium_ingot to orb
  else if inbox has ge 2 blue_ice and orb has eq 0 then
      input 2 blue_ice from inbox
      output retain 2 blue_ice to orb_2
  end
end
